{
  "name": "shapit",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "yarn npm audit --recursive --severity high",
    "check": "yarn typecheck && yarn lint && yarn format:check"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxlint": "1.77.0",
    "prettier": "3.9.6",
    "tsx": "4.23.9",
    "typescript": "7.0.2"
  },
  "packageManager": "yarn@4.18.0"
}
